{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "experimentalDecorators": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true
